{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/bin/simple-eng\" hook session-start || echo 'simple-eng: python3 was not found, so project state was not loaded.'",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(simple-eng:)?(approve|reject)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/simple-eng", "hook", "prompt-expansion"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/simple-eng", "hook", "pre-tool-use"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
